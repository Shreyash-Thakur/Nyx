# Nyx backend configuration — copy this file to `.env` and edit as needed.
#
# For a fresh local clone you do NOT need to edit anything here:
# all values below have safe development defaults baked into app/config.py.
# This file exists to document what's available and what you'd change for prod.

# ── App ────────────────────────────────────────────────────────────────────────
APP_ENV=development            # development | staging | production
APP_NAME=Nyx
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=console             # console (dev) | json (prod)
ALLOWED_HOSTS=*                # comma-separated in prod, e.g. nyx.example.com

# ── Secrets ────────────────────────────────────────────────────────────────────
# Generate strong values for production:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-insecure-secret-change-me-in-production
JWT_SECRET_KEY=dev-insecure-jwt-secret-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ───────────────────────────────────────────────────────────────────
# Default: file-backed SQLite at backend/nyx.db (no install required).
# For PostgreSQL:
#   DATABASE_URL=postgresql://nyx:nyx@localhost:5432/nyx
DATABASE_URL=sqlite:///./nyx.db

# Pool tuning only applies to Postgres; ignored for SQLite.
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Queue / Redis ──────────────────────────────────────────────────────────────
# auto   = use Redis if reachable, else run jobs inline in the request thread
# inline = never use Redis (good for laptops, CI, demos)
# redis  = require Redis; fail loudly if unreachable
QUEUE_BACKEND=auto
REDIS_URL=redis://localhost:6379/0

# ── File storage ───────────────────────────────────────────────────────────────
STORAGE_BACKEND=local          # local | s3
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20

# S3 (only used when STORAGE_BACKEND=s3):
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=nyx-invoices
# S3_REGION=ap-south-1

# ── OCR ────────────────────────────────────────────────────────────────────────
# Tesseract + Poppler are OPTIONAL system dependencies. If missing, the API
# still runs and uploads still succeed — only the OCR worker job will fail
# gracefully. Install instructions are in the README.
TESSERACT_CMD=/usr/bin/tesseract
OCR_LANGUAGE=eng

# ── Workers ────────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=4
JOB_TIMEOUT=300
JOB_RESULT_TTL=86400
JOB_FAILURE_TTL=604800

# ── Reconciliation ─────────────────────────────────────────────────────────────
RECONCILIATION_TOLERANCE_PERCENT=0.01
RECONCILIATION_DUPLICATE_WINDOW_DAYS=30
