# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=production
DEBUG=false
LOG_FORMAT=json

# Generate both with: openssl rand -hex 32
SECRET_KEY=change-me-use-openssl-rand-hex-32
JWT_SECRET_KEY=change-me-use-openssl-rand-hex-32-different-value

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me-strong-db-password
DATABASE_URL=postgresql://ledgerflow:change-me-strong-db-password@db:5432/ledgerflow

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── CORS (comma-separated list of allowed frontend origins) ───────────────────
ALLOWED_HOSTS=https://your-frontend-domain.com

# ── Frontend API URL (public URL of your API, seen from the browser) ──────────
NEXT_PUBLIC_API_URL=https://your-api-domain.com

# ── JWT ───────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── File storage ──────────────────────────────────────────────────────────────
STORAGE_BACKEND=local
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=20

# For S3-compatible storage, set STORAGE_BACKEND=s3 and fill these in:
# S3_ENDPOINT_URL=https://s3.amazonaws.com
# S3_ACCESS_KEY_ID=your-access-key-id
# S3_SECRET_ACCESS_KEY=your-secret-access-key
# S3_BUCKET_NAME=ledgerflow-invoices
# S3_REGION=ap-south-1

# ── Workers ───────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=4
JOB_TIMEOUT=300

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
