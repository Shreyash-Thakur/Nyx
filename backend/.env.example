# ── Application ──────────────────────────────────────────────
APP_ENV=development
APP_NAME=LedgerFlow
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALLOWED_HOSTS=*

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://ledgerflow:ledgerflow@db:5432/ledgerflow
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-separate-secret-key-for-jwt
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── File Storage ──────────────────────────────────────────────
STORAGE_BACKEND=local
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=20

# S3-compatible (set STORAGE_BACKEND=s3 to use)
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=ledgerflow-invoices
S3_REGION=ap-south-1

# ── OCR ───────────────────────────────────────────────────────
TESSERACT_CMD=/usr/bin/tesseract
OCR_LANGUAGE=eng

# ── Workers ───────────────────────────────────────────────────
WORKER_CONCURRENCY=4
JOB_TIMEOUT=300
JOB_RESULT_TTL=86400
JOB_FAILURE_TTL=604800

# ── Reconciliation ────────────────────────────────────────────
RECONCILIATION_TOLERANCE_PERCENT=0.01
RECONCILIATION_DUPLICATE_WINDOW_DAYS=30

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
